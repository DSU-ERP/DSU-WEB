{
  "name": "dsu-agentic-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "speech:setup": "node scripts/setup-interview-speech.mjs",
    "predev": "node scripts/setup-interview-speech.mjs",
    "prebuild": "node scripts/setup-interview-speech.mjs",
    "dev": "node node_modules/next/dist/bin/next dev --webpack",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node scripts/test.mjs",
    "assets:validate": "node scripts/validate-assets.mjs",
    "test:placement-ui": "node scripts/verify-placement-ui.cjs",
    "env:setup": "node scripts/setup-env.mjs",
    "env:check": "node scripts/check-env.mjs",
    "test:student-ui": "node scripts/verify-student-ui.cjs",
    "test:ui": "npm run test:placement-ui && npm run test:friday-ui && npm run test:student-ui && npm run test:student-journeys && npm run test:registration-ui && npm run test:intelligence-ui && npm run test:interview-ui",
    "test:registration-ui": "node scripts/verify-registration-ui.cjs",
    "test:intelligence-ui": "node scripts/verify-intelligence-ui.cjs",
    "test:student-journeys": "node scripts/verify-student-journeys.cjs",
    "test:friday-ui": "node scripts/verify-friday-ui.cjs",
    "test:interview-ui": "node scripts/verify-interview-workspace.cjs && node scripts/verify-interview-conversation.cjs && node scripts/verify-interview-security.cjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@openrouter/sdk": "^1.4.25",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "3.15.0",
    "lucide-react": "1.16.0",
    "next": "^16.4.0",
    "nodemailer": "^10.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "25.9.1",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
