NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Optional for portal reads; required only for CSV uploads. HTTPS in production.
DSU_BACKEND_URL=http://localhost:4000

# Optional Placement Officer assistant integrations. Server-side values only.
# Without Brave, the assistant provides an external search link.
# Email drafts remain available without SMTP; sending is disabled.
BRAVE_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=
SMTP_APP_PASSWORD=
