NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Optional for portal reads; required only for CSV uploads. HTTPS in production.
DSU_BACKEND_URL=http://localhost:4000

# Optional Placement Officer assistant integrations. Server-side values only.
# Without Brave, the assistant provides an external search link.
# Email drafts remain available without SMTP; sending is disabled.
BRAVE_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# F.R.I.D.A.Y. assistant. Server-side only; never prefix these with NEXT_PUBLIC_.
# Without OPENROUTER_API_KEY the assistant page loads and history stays
# readable, but replies are disabled with a visible notice.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_PROVIDER=baseten/fp8

# Optional server speech providers. Leave blank to use the browser's built-in
# speech recognition and synthesis, whose voices differ between devices.
FRIDAY_STT_PROVIDER=
FRIDAY_STT_API_KEY=
FRIDAY_STT_MODEL=

FRIDAY_TTS_PROVIDER=
FRIDAY_TTS_API_KEY=
FRIDAY_TTS_MODEL=
FRIDAY_TTS_VOICE_ID=
