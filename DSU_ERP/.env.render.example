# Next.js server. No database passwords, admin URLs or service-role keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Required for all campus, placement and student application data.
DSU_BACKEND_URL=https://YOUR_BACKEND.onrender.com
# Use your public web/custom domain; otherwise RENDER_EXTERNAL_URL is used.
DSU_WEB_URL=https://YOUR_WEB.onrender.com
# Optional assistant integrations; values stay on the web server.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_PROVIDER=baseten/fp8
BRAVE_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=
SMTP_APP_PASSWORD=
# Speech currently uses browser APIs. There are no server speech credentials.
# Production multi-instance builds need the SAME base64 32-byte key on all replicas.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Optional release identifier; Render sets RENDER_GIT_COMMIT automatically.
DEPLOYMENT_ID=
